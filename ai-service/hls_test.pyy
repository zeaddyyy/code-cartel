import subprocess
import numpy as np
import time

HLS_URL = "https://live.corp8.cloud/live/stream/13/index.m3u8"

WIDTH = 640
HEIGHT = 360
FRAME_SIZE = WIDTH * HEIGHT * 3

cmd = [
    "ffmpeg",

    "-hide_banner",
    "-loglevel", "warning",

    # HLS/network resilience
    "-reconnect", "1",
    "-reconnect_streamed", "1",
    "-reconnect_at_eof", "1",
    "-reconnect_delay_max", "5",

    # Start close to the live edge
    "-live_start_index", "-2",

    "-i", HLS_URL,

    # Reduce workload before Python/YOLO
    "-vf", "scale=640:360",

    # Raw BGR frames for NumPy/OpenCV
    "-f", "rawvideo",
    "-pix_fmt", "bgr24",

    "-an",
    "pipe:1",
]

print("Connecting to Sentinel Camera 13...")
print("FFmpeg → 640x360 → Python")

process = subprocess.Popen(
    cmd,
    stdout=subprocess.PIPE,
    stderr=subprocess.PIPE,
    bufsize=10**8,
)

frame_count = 0
start = time.time()

try:
    while frame_count < 30:

        raw = process.stdout.read(FRAME_SIZE)

        if len(raw) == 0:
            print("❌ FFmpeg stopped producing frames")
            break

        if len(raw) != FRAME_SIZE:
            print(
                f"⚠️ Incomplete frame: "
                f"{len(raw)}/{FRAME_SIZE} bytes"
            )
            break

        frame = np.frombuffer(
            raw,
            dtype=np.uint8
        ).reshape((HEIGHT, WIDTH, 3))

        frame_count += 1

        if frame_count % 5 == 0:
            elapsed = time.time() - start

            print(
                f"Frames: {frame_count} | "
                f"Elapsed: {elapsed:.2f}s | "
                f"Shape: {frame.shape}"
            )

finally:
    process.terminate()

    try:
        process.wait(timeout=3)
    except subprocess.TimeoutExpired:
        
